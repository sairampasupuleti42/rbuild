{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "rbuild": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rbuild",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              "src/manifest.webmanifest",
              "src/icon-192.png",
              "src/icon-512.png",
              "src/sw.js"
            ],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "rbuild:build:production",
            "tsConfig": "tsconfig.spec.json",
            "coverage": true,
            "coverageInclude": ["src/app/app.component.ts"],
            "coverageThresholds": {
              "perFile": true,
              "statements": 95,
              "branches": 95,
              "functions": 95,
              "lines": 95
            }
          }
        }
      }
    }
  }
}
